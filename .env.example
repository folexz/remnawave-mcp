# Remnawave panel origin — no trailing /api. The panel is only reliably reachable over its
# public HTTPS origin: 127.0.0.1:3000 does not answer even on the panel host itself.
REMNAWAVE_BASE_URL=https://panel.example.com

# READ token is required — the server refuses to start without it.
# Create it in the panel: Settings -> API tokens (grant read scopes only).
# REMNAWAVE_API_TOKEN is accepted as an alias, matching the panel's own .env variable name.
REMNAWAVE_API_TOKEN_READ=eyJhbGciOi...

# WRITE token is optional. Without it, mutating tools (POST/PATCH/PUT/DELETE) are NOT
# registered — the server is physically read-only.
REMNAWAVE_API_TOKEN_WRITE=eyJhbGciOi...

# Optional overrides
# REMNAWAVE_TOOL_PROFILE=minimal          # minimal (default) | core | full
# REMNAWAVE_CONTROLLERS=users,nodes,hosts # overrides the profile's typed-tool selection
# REMNAWAVE_MAX_SCHEMA_BYTES=2000         # collapse bigger schemas in tools/list
# REMNAWAVE_WRITE_MIN_INTERVAL_MS=1500    # throttle between mutations (config pushes restart Xray)
# REMNAWAVE_MAX_RETRIES=3
# REMNAWAVE_TIMEOUT_MS=30000
# REMNAWAVE_SKIP_CONFIRM=0                # 1 disables the confirm=true gate on destructive ops
